# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
.planning/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated build outputs
/build_testflight_*/
/dist/
*.apk
*.aab
*.ipa
*.dSYM/

# Nested native build caches
**/.cxx/
**/.gradle/
**/android/build/

# Local Luxand FaceSDK licenses. Build with
# --dart-define-from-file=.luxand.env.json
.luxand.env*.json
!.luxand.env.example.json

# Local environment files
.env
.env.*
!.env.example
!.env.example.*

# Signing credentials and per-user IDE state
android/key.properties
*.jks
*.keystore
*.p8
*.p12
*.pem
*.mobileprovision
**/xcuserdata/
*.xcuserstate

# Local captures and test data may contain identity documents or biometrics
/captures/
/screenshots/
/test_artifacts/

# Luxand native SDK is proprietary and must be provisioned locally
/packages/flutter_face_sdk/android/src/main/jniLibs/
/packages/flutter_face_sdk/ios/Frameworks/
/packages/flutter_face_sdk/third_party/luxand/license.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
